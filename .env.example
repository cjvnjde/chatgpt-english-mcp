# OpenAI Secure MCP Tunnel
CONTROL_PLANE_API_KEY=sk-replace-me
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_me

# Direct external access only. Generate with: openssl rand -base64 32
MCP_BEARER_TOKEN=

# One owner namespace per deployment. Models never pass this value to tools.
MCP_OWNER_KEY=default

# Latest stable tunnel-client release verified on 2026-08-30.
TUNNEL_CLIENT_VERSION=v0.0.13

CAMBRIDGE_TIMEOUT_SECONDS=20
LOG_LEVEL=info
LOG_FORMAT=json

# AnkiWeb sync. Set these in Dokploy Environment or your local .env.
# Generate a separate export token with: openssl rand -base64 32
ANKI_EXPORT_TOKEN=
ANKIWEB_USERNAME=
# Keep local .env passwords single-quoted so $ characters stay literal.
ANKIWEB_PASSWORD=''
ANKI_SOURCE_NAMESPACE=english-mcp
ANKI_DECK=English MCP
ANKI_POLL_SECONDS=60
# The Compose stack enables Anki sync; no override file or secret files required.
