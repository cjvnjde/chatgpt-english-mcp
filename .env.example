# OpenAI Secure MCP Tunnel
CONTROL_PLANE_API_KEY=sk-replace-me
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_me

# One owner namespace per deployment. Models never pass this value to tools.
MCP_OWNER_KEY=default

# Latest stable tunnel-client release verified on 2026-08-30.
TUNNEL_CLIENT_VERSION=v0.0.13

DICTIONARY_CACHE_TTL_DAYS=30
CAMBRIDGE_TIMEOUT_SECONDS=20
LOG_LEVEL=info
LOG_FORMAT=json
